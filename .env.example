# Copy this file to .env and change the values if needed
PORT=3000
DB_FILE=study-buddy.db
# Generate your own: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Free key from https://aistudio.google.com/apikey (never commit the real key)
GEMINI_API_KEY=
# Models to try in order (comma separated): if the first is busy, the next is used
GEMINI_MODEL=gemini-3.1-flash-lite,gemini-3.5-flash
# Model that turns text into vectors for search by meaning
EMBEDDING_MODEL=gemini-embedding-001
